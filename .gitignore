# ─────────────────────────────────────────────────────────────
# .NET
# ─────────────────────────────────────────────────────────────
bin/
obj/
*.user
.vs/
[Dd]ebug/
[Rr]elease/
*.dll
*.pdb

# ─────────────────────────────────────────────────────────────
# Node / Vite (TaskFlow.Web)
# ─────────────────────────────────────────────────────────────
node_modules/
dist/
dist-ssr/
*.local
.vite/

# ─────────────────────────────────────────────────────────────
# Environment / secrets
# ─────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
appsettings.Secrets.json

# ─────────────────────────────────────────────────────────────
# SQLite local database (dev only — never commit)
# ─────────────────────────────────────────────────────────────
*.db
*.db-shm
*.db-wal

# ─────────────────────────────────────────────────────────────
# IDE / OS
# ─────────────────────────────────────────────────────────────
.idea/
*.suo
.DS_Store
Thumbs.db

# ─────────────────────────────────────────────────────────────
# Claude Code — machine-local tool-permission cache, never shared.
# .claude/launch.json (dev-server preview config) IS committed.
# ─────────────────────────────────────────────────────────────
.claude/settings.local.json

# ─────────────────────────────────────────────────────────────
# Test / coverage
# ─────────────────────────────────────────────────────────────
[Tt]est[Rr]esults/
coverage/
*.trx
test-results.txt
# Coverlet's JSON report — non-deterministic, embeds absolute local file paths (incl. username).
# Flagged by Copilot's automated review (PR #43, round 3): it was tracked despite this section's
# own clear intent to exclude coverage artifacts, since it lives outside coverage/ and isn't *.trx.
coverage.json

# ─────────────────────────────────────────────────────────────
# Cloud sync artifacts (Google Drive, OneDrive, Dropbox)
# Google Drive stages uploads in .tmp.driveupload — never commit it.
# ─────────────────────────────────────────────────────────────
.tmp.driveupload/
.tmp.drivedownload/
*.driveupload
*.drivedownload
desktop.ini
Icon?
.~lock.*
~$*
